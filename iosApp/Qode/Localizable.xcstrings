    "delete_account_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete your account and all your content, including posts, promocodes, and interactions. This action cannot be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит ваш аккаунт и весь ваш контент, включая посты, промокоды и взаимодействия. Это действие невозможно отменить."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сіздің аккаунтыңызды және барлық контентіңізді, соның ішінде посттарды, промокодтарды және әрекеттерді мәңгілікке жояды. Бұл әрекетті қайтаруға болмайды."
          }
        }
      }
    },
